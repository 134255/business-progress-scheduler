.analysis { color: #1f2937; font-size: 28rpx; line-height: 1.6; min-width: 0; }
.analysis-heading { font-weight: 700; margin-top: 16rpx; overflow-wrap: anywhere; word-break: break-all; }
.analysis-note { color: #64748b; font-size: 24rpx; margin: 12rpx 0; overflow-wrap: anywhere; word-break: break-all; }
.analysis-notice, .analysis-error { padding: 18rpx; border-radius: 12rpx; background: #ecfdf5; margin: 14rpx 0; word-break: break-all; }
.analysis-error { color: #9a3412; background: #fff7ed; }
.analysis-node, .analysis-panel { background: white; border-radius: 20rpx; padding: 22rpx; margin: 18rpx 0; box-sizing: border-box; min-width: 0; }
.analysis-button, .analysis-node-button, .analysis-choice { display: block; width: 100%; box-sizing: border-box; margin: 16rpx 0 0; padding: 16rpx 20rpx; font-size: 26rpx; line-height: 1.5; height: auto; white-space: normal; word-break: break-all; overflow-wrap: anywhere; color: #0f766e; background: #ecfdf5; border: 1rpx solid #99f6e4; border-radius: 12rpx; }
.analysis-node-button { text-align: left; margin-top: 0; font-weight: 700; }
.analysis-tools { margin: 20rpx 0; }
.analysis-picker { padding: 18rpx; background: #f8fafc; border: 1rpx solid #d1d5db; border-radius: 12rpx; margin-top: 14rpx; white-space: normal; word-break: break-all; }
.analysis-path { margin-top: 20rpx; padding: 18rpx; background: #f0fdfa; border-radius: 12rpx; word-break: break-all; }
.analysis-field { margin-top: 22rpx; border-top: 1rpx solid #e2e8f0; }
.analysis-option { display: flex; align-items: flex-start; gap: 20rpx; margin-top: 14rpx; padding: 10rpx 0; border-bottom: 1rpx solid #f1f5f9; min-width: 0; }
.analysis-label { flex: 1; min-width: 0; word-break: break-all; overflow-wrap: anywhere; }
.analysis-count { flex: 0 0 auto; color: #0f766e; font-size: 24rpx; }
.analysis-choice { margin: 0; text-align: left; }
.analysis-choice-count { display: block; text-align: right; margin-top: 8rpx; font-size: 24rpx; }
