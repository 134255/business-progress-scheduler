page {
  background: #f4f7f7;
  color: #1f2937;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 118, 110, 0.06);
}

.title {
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 700;
}

.section-title {
  font-size: 32rpx;
  font-weight: 650;
  margin-bottom: 20rpx;
}

.muted {
  color: #6b7280;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.primary-button {
  background: #0f766e;
  color: #ffffff;
  border-radius: 14rpx;
}

.secondary-button {
  background: #ecfdf5;
  color: #0f766e;
  border: 1rpx solid #99f6e4;
  border-radius: 14rpx;
}

.danger-button {
  background: #fff1f2;
  color: #be123c;
  border: 1rpx solid #fecdd3;
  border-radius: 14rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #374151;
  font-weight: 600;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f9fafb;
  border: 1rpx solid #d1d5db;
  border-radius: 12rpx;
  padding: 20rpx;
}

.textarea {
  min-height: 180rpx;
}

.empty {
  padding: 72rpx 24rpx;
  text-align: center;
  color: #9ca3af;
}

