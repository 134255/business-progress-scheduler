<view class="page">
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view wx:if="{{readOnly}}" class="readonly-banner">模板已启用，定义为只读。请先停用后再编辑。</view>

  <view class="card">
    <view class="field">
      <label class="field-label" for="template-name">模板名称</label>
      <input id="template-name" class="input" value="{{name}}" maxlength="60" disabled="{{readOnly || loading}}" bindinput="onNameInput" />
    </view>
    <view class="field">
      <label class="field-label" for="template-description">模板说明</label>
      <textarea id="template-description" class="textarea" value="{{description}}" maxlength="500" disabled="{{readOnly || loading}}" bindinput="onDescriptionInput" />
    </view>
    <view wx:if="{{editMode}}" class="meta">状态：{{status === 'enabled' ? '已启用' : status === 'disabled' ? '已停用' : '草稿'}} · 版本 {{version}}</view>
  </view>

  <view class="row-between section-head">
    <view class="section-title">节点定义（{{nodes.length}}）</view>
    <view class="actions">
      <button wx:if="{{editMode}}" size="mini" class="secondary-button" bindtap="openFlowPreview">流程预览</button>
      <button wx:if="{{!readOnly}}" size="mini" class="secondary-button" bindtap="openNodeEditor">新增节点</button>
    </view>
  </view>

  <view wx:if="{{flowSchemaVersion === 2 && nodes.length}}" class="card graph-settings">
    <text class="field-label">流程入口</text>
    <picker range="{{nodes}}" range-key="name" disabled="{{readOnly}}" bindchange="onEntryNodeChange">
      <view class="picker-value">{{entryNodeKey || '请选择入口节点'}}</view>
    </picker>
    <text class="muted">每个节点可独立配置固定、单选分支、人工决定或结束；支持分支后继续分支及多条路径汇合。</text>
  </view>

  <view wx:if="{{nodes.length}}">
    <view class="card node-card" wx:for="{{nodes}}" wx:key="_uiKey">
      <view class="row-between">
        <view><view class="node-name">{{index + 1}}. {{item.name}} <text wx:if="{{flowSchemaVersion === 2 && item.nodeKey === entryNodeKey}}" class="entry-badge">入口</text></view><text class="muted">{{item.activationMode === 'optional_tail' ? '可选追加节点 · ' : ''}}处理人 {{item.includeBusinessCreatorAsProcessor ? '含售后发起人 + ' : ''}}{{item.processorAssignmentMode === 'business_creator' ? '售后发起人' : (item.workflowMode === undefined ? item.assigneeUserIds.length + ' 人' : (item.processorUserIds ? item.processorUserIds.length : 0) + ' 人')}} · 审核人 {{item.reviewerAssignmentMode === 'business_creator' ? '售后发起人' : (item.workflowMode === undefined ? '0 人' : (item.reviewerUserIds ? item.reviewerUserIds.length : 0) + ' 人')}} · {{item.reviewerAssignmentMode === 'fixed_accounts' && (!item.reviewerUserIds || !item.reviewerUserIds.length) ? '无需审核' : (item.reviewMode === 'all' ? '会签' : '或签')}} · 处理 {{item.processingSlaWorkHours === undefined ? 22 : item.processingSlaWorkHours}} 小时 · 审核 {{item.reviewSlaWorkHours === undefined ? 8 : item.reviewSlaWorkHours}} 小时</text></view>
        <text class="muted">字段 {{item.fields.length}} 个</text>
      </view>
      <view class="node-meta">{{item.requiresEvidence ? '需要凭证' : '无需凭证'}}</view>
      <view wx:if="{{flowSchemaVersion === 2}}" class="node-meta">后续：{{item.next.mode === 'end' ? '结束售后' : item.next.mode === 'default' ? '固定下一节点' : item.next.mode === 'single_select' ? '单选分支' : '人工决定'}}</view>
      <view class="actions">
        <button size="mini" data-index="{{index}}" bindtap="openNodeEditor">{{readOnly ? '查看' : '编辑'}}</button>
        <button wx:if="{{!readOnly && index > 0 && item.activationMode !== 'optional_tail' && nodes[index - 1].activationMode !== 'optional_tail'}}" size="mini" data-index="{{index}}" data-direction="-1" bindtap="moveNode">上移</button>
        <button wx:if="{{!readOnly && index + 1 < nodes.length && item.activationMode !== 'optional_tail' && nodes[index + 1].activationMode !== 'optional_tail'}}" size="mini" data-index="{{index}}" data-direction="1" bindtap="moveNode">下移</button>
        <button wx:if="{{!readOnly}}" size="mini" class="danger-button" data-index="{{index}}" bindtap="removeNode">删除</button>
      </view>
    </view>
  </view>
  <view class="empty" wx:else>尚未添加节点</view>

  <view wx:if="{{!readOnly}}" class="footer-actions">
    <button class="primary-button" bindtap="submit" loading="{{submitting || loading}}" disabled="{{submitting || loading}}">保存模板</button>
    <button wx:if="{{editMode}}" class="secondary-button" bindtap="enableTemplate" loading="{{submitting}}" disabled="{{submitting || loading}}">启用当前已保存版本</button>
  </view>
  <button wx:if="{{readOnly}}" class="secondary-button" bindtap="disableTemplate" loading="{{submitting}}" disabled="{{submitting || loading}}">停用后编辑</button>
</view>
