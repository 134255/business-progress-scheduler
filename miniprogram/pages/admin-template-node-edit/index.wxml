<view class="page">
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view wx:if="{{readOnly}}" class="readonly-banner">模板已启用，此节点只能查看。</view>

  <view class="card">
    <view class="field">
      <label class="field-label" for="node-name">节点名称</label>
      <input id="node-name" class="input" value="{{name}}" maxlength="60" disabled="{{readOnly}}" bindinput="onNameInput" />
    </view>
    <view class="field">
      <label class="field-label" for="node-description">节点说明</label>
      <textarea id="node-description" class="textarea" value="{{description}}" maxlength="500" disabled="{{readOnly}}" bindinput="onDescriptionInput" />
    </view>
    <view class="field" wx:if="{{flowSchemaVersion !== 2}}">
      <text class="field-label">节点启用方式</text>
      <label class="assignment-mode-row">
        <switch checked="{{activationMode === 'optional_tail'}}" disabled="{{readOnly || optionalTailExistsOutsideCurrentNode}}" bindchange="onOptionalTailChange" />
        可选追加节点
      </label>
      <text class="muted" wx:if="{{activationMode === 'optional_tail'}}">只能位于模板最后；前序节点完成后，由本节点候选处理人决定启用或跳过。</text>
      <text class="muted" wx:elif="{{optionalTailExistsOutsideCurrentNode}}">本模板已经设置了一个可选追加节点。</text>
    </view>
    <view class="field sla-grid">
      <view>
        <label class="field-label" for="node-processing-sla">处理 SLA 工时</label>
        <input id="node-processing-sla" class="input" type="digit" value="{{processingSlaWorkHours}}" disabled="{{readOnly}}" bindinput="onProcessingSlaInput" />
      </view>
      <view>
        <label class="field-label" for="node-review-sla">审核 SLA 工时</label>
        <input id="node-review-sla" class="input" type="digit" value="{{reviewSlaWorkHours}}" disabled="{{readOnly}}" bindinput="onReviewSlaInput" />
      </view>
    </view>
    <view class="field" wx:if="{{flowSchemaVersion === 2}}">
      <text class="field-label">处理人来源</text>
      <label class="assignment-mode-row">
        <switch checked="{{includeBusinessCreatorAsProcessor}}" disabled="{{readOnly}}" bindchange="onIncludeBusinessCreatorAsProcessorChange" />
        售后发起人作为该节点处理人
      </label>
      <text class="muted">勾选后，售后发起人会加入下方固定处理人；系统自动去重，不再强制唯一。</text>
    </view>
    <view class="field" wx:else>
      <text class="field-label">处理人来源</text>
      <label class="assignment-mode-row">
        <switch checked="{{processorAssignmentMode === 'business_creator'}}" disabled="{{readOnly}}" bindchange="onProcessorAssignmentModeChange" />
        售后发起人作为本节点唯一处理人（旧模板）
      </label>
      <text class="muted" wx:if="{{processorAssignmentMode === 'business_creator'}}">创建售后时将当前售后发起人固化为唯一处理人；其他节点不受影响。</text>
    </view>
    <view class="field">
      <text class="field-label">处理人</text>
      <view class="option-list">
        <label wx:for="{{accountOptions}}" wx:key="_id" data-id="{{item._id}}" bindtap="onProcessorToggle">
          <checkbox checked="{{item.processorSelected}}" disabled="{{readOnly || processorAssignmentMode === 'business_creator'}}" />{{item.displayName || item.username}}（@{{item.username}}）
        </label>
      </view>
    </view>
    <view class="field">
      <text class="field-label">审核人来源</text>
      <label class="assignment-mode-row">
        <switch checked="{{reviewerAssignmentMode === 'business_creator'}}" disabled="{{readOnly}}" bindchange="onReviewerAssignmentModeChange" />
        售后发起人作为本节点唯一审核人
      </label>
      <text class="muted" wx:if="{{reviewerAssignmentMode === 'business_creator'}}">创建售后时将当前售后发起人固化为唯一审核人；本节点不再选择固定审核账号。</text>
    </view>
    <view class="field" wx:if="{{reviewerAssignmentMode === 'fixed_accounts'}}">
      <text class="field-label">审核人</text>
      <view class="option-list">
        <label wx:for="{{accountOptions}}" wx:key="_id" data-id="{{item._id}}" bindtap="onReviewerToggle">
          <checkbox checked="{{item.reviewerSelected}}" disabled="{{readOnly}}" />{{item.displayName || item.username}}（@{{item.username}}）
        </label>
      </view>
      <radio-group wx:if="{{reviewerUserIds.length}}" class="review-mode" bindchange="onReviewModeChange">
        <label><radio value="any" checked="{{reviewMode === 'any'}}" disabled="{{readOnly}}" />或签（任一审核人通过）</label>
        <label><radio value="all" checked="{{reviewMode === 'all'}}" disabled="{{readOnly}}" />会签（全部审核人通过）</label>
      </radio-group>
      <text wx:else class="muted">无需审核，处理人可直接完成</text>
    </view>
    <view class="field" wx:else>
      <text class="field-label">审核人</text>
      <text>售后创建时自动使用该售后发起人</text>
    </view>
    <view class="field">
      <text class="field-label">凭证要求</text>
      <label><switch checked="{{requiresEvidence}}" disabled="{{readOnly}}" bindchange="onRequiresEvidenceChange" />提交审核时必须上传凭证</label>
      <text class="muted">未勾选时凭证可选；未选择格式表示不限格式（仅限系统已支持格式）。</text>
      <checkbox-group class="evidence-options" bindchange="onEvidenceTypesChange">
        <label wx:for="{{evidenceTypeOptions}}" wx:key="value">
          <checkbox value="{{item.value}}" checked="{{item.selected}}" disabled="{{readOnly}}" />{{item.label}}
        </label>
      </checkbox-group>
    </view>

    <view class="field route-panel" wx:if="{{flowSchemaVersion === 2}}">
      <text class="field-label">本节点完成后的去向</text>
      <picker range="{{nextModeLabels}}" disabled="{{readOnly}}" bindchange="onNextModeChange">
        <view class="picker-value">{{nextMode === 'end' ? '结束售后' : nextMode === 'default' ? '固定进入下一节点' : nextMode === 'single_select' ? '按本节点单选字段分支' : '完成后由处理人决定'}}</view>
      </picker>
      <view wx:if="{{nextMode === 'default'}}">
        <text class="muted">固定目标</text>
        <picker range="{{nodeTargetOptions}}" range-key="name" disabled="{{readOnly}}" bindchange="onDefaultTargetChange">
          <view class="picker-value">{{defaultTarget || '请选择目标节点'}}</view>
        </picker>
      </view>
      <view wx:elif="{{nextMode === 'single_select'}}">
        <text class="muted">用于分流的单选字段必须必填、且不能是条件字段。</text>
        <picker range="{{routingFieldOptions}}" range-key="name" disabled="{{readOnly}}" bindchange="onRoutingFieldChange">
          <view class="picker-value">{{routingFieldKey || '请选择单选字段'}}</view>
        </picker>
        <view class="route-row" wx:for="{{routeOptionRows}}" wx:key="option">
          <text>{{item.option}}</text>
          <picker range="{{targetOptions}}" range-key="name" value="{{item.targetIndex}}" disabled="{{readOnly}}" data-option="{{item.option}}" bindchange="onRouteOptionTargetChange">
            <view class="picker-value route-target">{{item.target}}</view>
          </picker>
        </view>
      </view>
      <view wx:elif="{{nextMode === 'manual'}}">
        <text class="muted">节点完成后，开启目标节点的处理人可选择开启或跳过。</text>
        <picker range="{{nodeTargetOptions}}" range-key="name" disabled="{{readOnly}}" bindchange="onManualActivateTargetChange">
          <view class="picker-value">开启后：{{manualActivateTarget || '请选择'}}</view>
        </picker>
        <picker range="{{targetOptions}}" range-key="name" disabled="{{readOnly}}" bindchange="onManualSkipTargetChange">
          <view class="picker-value">跳过后：{{manualSkipTarget || '请选择'}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="row-between section-head">
    <view class="section-title">动态字段（{{fields.length}}）</view>
    <button wx:if="{{!readOnly}}" size="mini" class="secondary-button" bindtap="addField">新增字段</button>
  </view>
  <view class="card linkage-panel">
    <view class="section-title">商品严格联动</view>
    <text class="linkage-note">按完整组合联动分类、品牌、型号和属性1至属性5；选项中的逗号、换行保留原文。</text>
    <view wx:if="{{linkageSummary}}" class="linkage-summary">
      <text>{{linkageSummary.rowCount}} 个合法组合 · {{linkageSummary.modelCount}} 个型号组 · {{linkageSummary.fieldCount}} 个字段</text>
      <text class="linkage-note">成员只能通过结构化导入整体更新，不能单独修改、删除或重排。</text>
    </view>
    <button wx:if="{{!readOnly}}" size="mini" class="secondary-button" bindtap="openLinkageImport">{{linkageSummary ? '整体更新商品联动' : '导入商品联动 JSON'}}</button>
    <button wx:if="{{linkageImportPreview || linkageSummary}}" size="mini" class="secondary-button trial-button" bindtap="openLinkageTrial">只读试选商品组合</button>
    <view wx:if="{{linkageTrialOpen}}" class="linkage-trial">
      <view class="section-title">只读试选 · {{linkageTrialSource}}</view>
      <text class="linkage-note">仅检查联动候选，不更改节点或模板草稿，不创建售后、不保存填写内容。每个选项都需手动选择；不适用属性自动跳过。</text>
      <view wx:for="{{linkageTrialFields}}" wx:key="fieldKey" wx:for-item="trialField">
        <text>{{trialField.name}}</text>
        <picker range="{{trialField.choiceLabels}}" value="{{trialField.valueIndex + 1}}" data-field-key="{{trialField.fieldKey}}" bindchange="onLinkageTrialChange">
          <view class="picker-value">{{trialField.valueIndex < 0 ? '请选择（不会自动选择唯一选项）' : trialField.value}}</view>
        </picker>
      </view>
      <text class="linkage-note">{{linkageTrialComplete ? '试选为合法完整组合；未保存任何数据' : '请继续手动选择；下级只显示当前合法候选'}}</text>
      <button size="mini" bindtap="resetLinkageTrial">清空试选</button>
    </view>
    <view wx:if="{{linkageImportOpen && !readOnly}}">
      <text class="linkage-note">仅在当前节点草稿中替换 SKU、配置八个联动字段。保存节点后还须保存模板；不会直接写入数据库。</text>
      <textarea class="textarea linkage-input" maxlength="-1" placeholder="粘贴离线工具生成的完整结构化 JSON" bindinput="onLinkageImportInput" />
      <button size="mini" bindtap="validateLinkageImport">校验并预览</button>
      <view wx:if="{{linkageImportError}}" class="error">{{linkageImportError}}</view>
      <view wx:if="{{linkageImportPreview}}" class="linkage-summary">
        <text>校验通过：{{linkageImportPreview.rowCount}} 个组合，{{linkageImportPreview.modelCount}} 个型号组</text>
        <view wx:for="{{linkageImportPreview.fields}}" wx:key="name" wx:for-item="previewField" class="linkage-preview-row">
          <text>{{previewField.name}}</text><text>{{previewField.optionCount}} 个选项 · {{previewField.applicableCount}} 个适用组合</text>
        </view>
        <button class="primary-button" bindtap="applyLinkageImport">确认应用到节点草稿</button>
      </view>
    </view>
  </view>
  <view class="card field-card" wx:for="{{fields}}" wx:key="_uiKey">
    <view class="row-between field-heading"><text>字段 {{index + 1}}</text><text class="muted">{{item.fieldKey ? '稳定标识已保留' : '保存时生成标识'}}</text></view>
    <view wx:if="{{item.linked}}" class="linkage-summary">
      <text>{{item.name}} · 单选 · {{item.required ? '必填' : '选填'}}</text>
      <text class="linkage-note">{{item.description}}</text>
      <text class="linkage-note">商品联动成员，{{item.optionCount}} 个原文选项；请在上方整体更新。</text>
    </view>
    <block wx:else>
    <input class="input compact" value="{{item.name}}" placeholder="字段名称" disabled="{{readOnly}}" data-index="{{index}}" bindinput="onFieldNameInput" />
    <input class="input compact" value="{{item.description}}" placeholder="字段说明（可选）" disabled="{{readOnly}}" data-index="{{index}}" bindinput="onFieldDescriptionInput" />
    <picker range="{{fieldTypeLabels}}" value="{{item.type === 'short_text' ? 0 : item.type === 'long_text' ? 1 : item.type === 'number' ? 2 : item.type === 'boolean' ? 3 : item.type === 'date' ? 4 : item.type === 'single_select' ? 5 : 6}}" disabled="{{readOnly}}" data-index="{{index}}" bindchange="onFieldTypeChange">
      <view class="picker-value">类型：{{item.type}}</view>
    </picker>
    <label class="required-row"><switch checked="{{item.required}}" disabled="{{readOnly}}" data-index="{{index}}" bindchange="onFieldRequiredChange" />必填</label>

    <view wx:if="{{item.type === 'short_text' || item.type === 'long_text'}}" class="constraint-grid">
      <input class="input compact" type="number" value="{{item.constraints.minLength}}" placeholder="最小长度" disabled="{{readOnly}}" data-index="{{index}}" bindinput="onFieldMinLengthInput" />
      <input class="input compact" type="number" value="{{item.constraints.maxLength}}" placeholder="最大长度" disabled="{{readOnly}}" data-index="{{index}}" bindinput="onFieldMaxLengthInput" />
      <input class="input compact wide" value="{{item.constraints.pattern}}" placeholder="安全正则（可选）" disabled="{{readOnly}}" data-index="{{index}}" bindinput="onFieldPatternInput" />
    </view>
    <view wx:elif="{{item.type === 'number'}}" class="constraint-grid">
      <input class="input compact" type="digit" value="{{item.constraints.min}}" placeholder="最小值" disabled="{{readOnly}}" data-index="{{index}}" bindinput="onFieldMinInput" />
      <input class="input compact" type="digit" value="{{item.constraints.max}}" placeholder="最大值" disabled="{{readOnly}}" data-index="{{index}}" bindinput="onFieldMaxInput" />
      <input class="input compact wide" type="number" value="{{item.constraints.decimalPlaces}}" placeholder="小数位数" disabled="{{readOnly}}" data-index="{{index}}" bindinput="onFieldDecimalPlacesInput" />
    </view>
    <view wx:elif="{{item.type === 'single_select' || item.type === 'multi_select'}}">
      <textarea class="textarea option-editor" value="{{item.optionText}}" maxlength="-1" placeholder="选项用逗号或换行分隔，可整段粘贴" disabled="{{readOnly}}" data-index="{{index}}" bindinput="onFieldOptionsInput" />
      <text class="muted option-count">已识别 {{item.optionCount}} 个选项（重复项自动合并）</text>
    </view>

    <view class="condition-panel" wx:if="{{flowSchemaVersion === 2}}">
      <label class="assignment-mode-row">
        <switch checked="{{item.conditionEnabled}}" disabled="{{readOnly}}" data-index="{{index}}" bindchange="onFieldConditionChange" />
        根据前序单选字段显示
      </label>
      <view wx:if="{{item.conditionEnabled}}">
        <picker range="{{item.conditionParentOptions}}" range-key="name" value="{{item.conditionParentIndex}}" disabled="{{readOnly}}" data-index="{{index}}" bindchange="onFieldConditionParentChange">
          <view class="picker-value">依赖：{{item.condition.parentFieldKey}}</view>
        </picker>
        <text class="muted">父字段选择以下值时显示：</text>
        <checkbox-group class="evidence-options" data-index="{{index}}" bindchange="onFieldVisibleWhenChange">
          <label wx:for="{{item.conditionParentValueRows}}" wx:key="value" wx:for-item="parentOption">
            <checkbox value="{{parentOption.value}}" checked="{{parentOption.visible}}" disabled="{{readOnly}}" />{{parentOption.value}}
          </label>
        </checkbox-group>
        <view wx:if="{{item.lazyConditional}}" class="conditional-pagination">
          <text class="linkage-note">分批显示父选项（每页最多20项），其他页的选择保留；仅打开一个候选编辑框。</text>
          <view class="actions">
            <button size="mini" disabled="{{readOnly || item.conditionalPage === 0}}" data-index="{{index}}" data-direction="-1" bindtap="onConditionalParentPageChange">上一页</button>
            <text>{{item.conditionalPage + 1}} / {{item.conditionalPageCount}}</text>
            <button size="mini" disabled="{{readOnly || item.conditionalPage + 1 >= item.conditionalPageCount}}" data-index="{{index}}" data-direction="1" bindtap="onConditionalParentPageChange">下一页</button>
          </view>
        </view>
        <view wx:if="{{item.type === 'single_select'}}">
          <view wx:for="{{item.conditionParentValueRows}}" wx:key="value" wx:for-item="parentOption" class="conditional-option-row">
            <text wx:if="{{parentOption.visible}}" class="muted">{{parentOption.value}} 时可选：</text>
            <button wx:if="{{item.lazyConditional && parentOption.visible && !parentOption.editing}}" size="mini" disabled="{{readOnly}}" data-index="{{parentOption.fieldIndex}}" data-parent-value="{{parentOption.value}}" bindtap="onConditionalEditorOpen">编辑此父选项的候选</button>
            <textarea wx:if="{{parentOption.visible && (!item.lazyConditional || parentOption.editing)}}" class="textarea option-editor" value="{{parentOption.optionText}}" maxlength="-1" placeholder="填写本字段已有选项，用逗号或换行分隔" disabled="{{readOnly}}" data-index="{{parentOption.fieldIndex}}" data-parent-value="{{parentOption.value}}" bindinput="onFieldConditionalOptionsInput" />
            <text wx:if="{{parentOption.visible && (!item.lazyConditional || parentOption.editing)}}" class="muted option-count">已识别 {{parentOption.optionCount}} 个选项（重复项自动合并）</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{!readOnly}}" class="actions">
      <button wx:if="{{index > 0}}" size="mini" data-index="{{index}}" data-direction="-1" bindtap="moveField">上移</button>
      <button wx:if="{{index + 1 < fields.length}}" size="mini" data-index="{{index}}" data-direction="1" bindtap="moveField">下移</button>
      <button size="mini" class="danger-button" data-index="{{index}}" bindtap="removeField">删除</button>
    </view>
    </block>
  </view>

  <button wx:if="{{!readOnly}}" class="primary-button submit" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">保存节点</button>
</view>
