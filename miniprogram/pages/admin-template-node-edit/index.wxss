.error { margin-bottom: 24rpx; padding: 18rpx; color: #be123c; background: #fff1f2; border-radius: 12rpx; }
.readonly-banner { margin-bottom: 24rpx; padding: 20rpx; color: #92400e; background: #fef3c7; border-radius: 12rpx; }
.option-list { display: flex; flex-direction: column; gap: 18rpx; }
.option-list label { display: flex; align-items: center; }
.assignment-mode-row { display: flex; align-items: center; gap: 14rpx; }
.sla-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.review-mode { display: flex; flex-direction: column; gap: 18rpx; margin-top: 18rpx; }
.review-mode label { display: flex; align-items: center; }
.evidence-options { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 18rpx; }
.section-head { margin: 28rpx 4rpx 16rpx; }
.section-title { margin: 0; }
.field-heading { margin-bottom: 18rpx; font-weight: 600; }
.compact { margin-bottom: 16rpx; }
.picker-value { margin-bottom: 16rpx; padding: 20rpx; color: #0f766e; background: #ecfdf5; border-radius: 12rpx; }
.required-row { display: flex; align-items: center; margin-bottom: 18rpx; }
.constraint-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.constraint-grid .wide { grid-column: 1 / 3; }
.actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.actions button { margin: 0; }
.submit { margin-top: 28rpx; }
.route-panel, .condition-panel { padding: 20rpx; background: #f0fdfa; border: 1rpx solid #99f6e4; border-radius: 14rpx; }
.route-row { display: grid; grid-template-columns: minmax(120rpx, 1fr) 2fr; align-items: center; gap: 16rpx; }
.route-target { margin: 8rpx 0; }
.condition-panel { margin-top: 18rpx; }
.conditional-option-row { margin-top: 12rpx; }
