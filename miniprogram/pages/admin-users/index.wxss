.toolbar { padding-bottom: 20rpx; }
.search-row { display: flex; gap: 14rpx; }
.search-input { flex: 1; }
.search-button { width: 150rpx; margin: 0; }
.filter-row { margin-top: 22rpx; }
.filter { color: #0f766e; padding: 14rpx 0; }
.create-button { margin: 0; font-size: 26rpx; }
.user-name { font-size: 32rpx; font-weight: 650; margin-bottom: 6rpx; }
.status { padding: 6rpx 14rpx; border-radius: 999rpx; font-size: 24rpx; }
.status.active { color: #047857; background: #d1fae5; }
.status.disabled { color: #9f1239; background: #ffe4e6; }
.meta-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; margin: 26rpx 0; color: #4b5563; font-size: 25rpx; }
.actions { display: flex; flex-wrap: wrap; gap: 12rpx; }
.actions button { margin: 0; }
.more { margin-top: 12rpx; }
.total { display: block; text-align: center; margin-top: 18rpx; }
