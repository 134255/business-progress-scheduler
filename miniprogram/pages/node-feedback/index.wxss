.node-title { margin-top: 12rpx; }
.frozen-banner { margin-bottom: 20rpx; padding: 20rpx; border-radius: 14rpx; color: #92400e; background: #fffbeb; }
.dynamic-field { padding-bottom: 22rpx; border-bottom: 1rpx solid #e5e7eb; }
.field-description { display: block; margin: -8rpx 0 12rpx; font-size: 22rpx; }
.boolean-options, .multi-options { display: flex; flex-wrap: wrap; gap: 20rpx; }
.history-status { color: #0f766e; font-weight: 650; }
.history-comment { display: block; margin-top: 16rpx; line-height: 1.6; }
.vote-comment { white-space: pre-wrap; word-break: break-all; overflow-wrap: anywhere; line-height: 1.6; }
.review-history-vote { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #e5e7eb; }
.history-fields { margin-top: 18rpx; padding: 14rpx; border-radius: 12rpx; background: #f8fafc; }
.history-field { display: flex; justify-content: space-between; gap: 24rpx; padding: 8rpx 0; }
.history-evidence { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #e5e7eb; }
.file-name { display: block; max-width: 470rpx; word-break: break-all; }
.evidence-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 12rpx 0; }
.picker-error { margin: 12rpx 0; padding: 16rpx; border-radius: 12rpx; background: #fff7ed; }
.picker-diagnostic { word-break: break-all; font-size: 22rpx; }
.picker-error button { margin-top: 14rpx; }
.local-file { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 16rpx 0; border-bottom: 1rpx solid #e5e7eb; }
.local-file-main { min-width: 0; }
.remove, .error-text { color: #be123c; }
.error-text { display: block; margin-top: 6rpx; font-size: 22rpx; }
.download-all { margin-top: 20rpx; }
.video-mask { position: fixed; inset: 0; z-index: 20; display: flex; align-items: center; padding: 30rpx; background: rgba(15, 23, 42, .72); }
.video-panel { width: 100%; padding: 24rpx; border-radius: 20rpx; background: white; }
.video-player { width: 100%; margin-top: 20rpx; }
.block { display: block; margin-top: 10rpx; }
.review-summary { margin-top: 20rpx; padding-top: 14rpx; border-top: 1rpx solid #e5e7eb; }
.review-actions { display: grid; gap: 14rpx; }
.review-actions button { width: 100%; margin: 0; }
.readonly-tip { display: block; margin-top: 8rpx; text-align: center; }
.recognition-panel { margin-bottom: 26rpx; padding: 22rpx; border: 1rpx solid #99f6e4; border-radius: 16rpx; background: #f0fdfa; }
.recognition-text { margin-bottom: 16rpx; background: #fff; }
.recognition-preview { display: grid; gap: 16rpx; margin-top: 18rpx; }
.recognition-candidate { padding: 18rpx; border: 1rpx solid #d1d5db; border-radius: 14rpx; background: #fff; }
.recognition-warning { display: block; margin-top: 8rpx; color: #b45309; font-size: 22rpx; }
.compact-card { padding: 20rpx 24rpx; margin-bottom: 16rpx; border-radius: 14rpx; box-shadow: none; }
.compact-heading { color: #0f766e; font-size: 28rpx; font-weight: 650; }
.compact-note { display: block; margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; white-space: pre-wrap; word-break: break-all; }
.compact-fields { margin-top: 10rpx; }
.compact-field, .history-field { display: flex; align-items: flex-start; gap: 20rpx; padding: 12rpx 0; border-bottom: 1rpx solid #edf2ef; }
.compact-field:last-child, .history-field:last-child { border-bottom: 0; }
.compact-label { flex: 0 0 160rpx; color: #6b7280; font-size: 24rpx; line-height: 1.6; word-break: break-all; }
.compact-value { flex: 1; min-width: 0; font-size: 26rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-all; overflow-wrap: anywhere; }
.compact-subheading { margin-top: 16rpx; color: #374151; font-size: 24rpx; font-weight: 600; }
.compact-toggle { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0; padding: 16rpx 0; background: transparent; text-align: left; line-height: 1.5; font-size: 26rpx; color: #0f766e; border-radius: 0; }
.compact-toggle::after { border: 0; }
.section-toggle { margin: 12rpx 0; border-bottom: 1rpx solid #dce9e3; font-weight: 600; }
.revision-toggle { padding: 0; }
.revision-summary { flex: 1; min-width: 0; }
.fold-indicator { flex-shrink: 0; font-size: 22rpx; font-weight: 400; }
.history-fields { padding: 0; background: transparent; }
.history-comment { white-space: pre-wrap; word-break: break-all; }
.history-evidence { align-items: flex-start; font-size: 24rpx; line-height: 1.5; }
.history-evidence .file-name { flex: 1; min-width: 0; max-width: none; white-space: pre-wrap; overflow-wrap: anywhere; }
.evidence-state { flex-shrink: 0; max-width: 180rpx; font-size: 22rpx; }
.scan-field-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.scan-field-actions button { margin: 0; }
.scan-field-hint { flex: 1; min-width: 220rpx; font-size: 22rpx; line-height: 1.5; }
.readonly-header .node-title { margin-top: 6rpx; font-size: 32rpx; }
.compact-meta { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8rpx 16rpx; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #edf2ef; color: #6b7280; font-size: 22rpx; line-height: 1.5; word-break: break-all; }
.meta-wide { grid-column: 1 / -1; }
