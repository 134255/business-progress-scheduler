<view class="page">
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view wx:if="{{frozen}}" class="frozen-banner">业务已冻结，反馈历史和凭证保持只读。</view>

  <view class="card">
    <text class="muted">当前节点 {{nodeCode}}</text>
    <view class="title node-title">{{nodeName}}</view>
  </view>

  <view wx:if="{{canSubmit}}" class="card">
    <view class="field">
      <text class="field-label">节点状态</text>
      <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatus">
        <view class="input">{{statusOptions[statusIndex].label}}</view>
      </picker>
    </view>

    <view class="field dynamic-field" wx:for="{{fields}}" wx:key="fieldKey">
      <text class="field-label">{{item.name}}{{item.required ? ' *' : ''}}</text>
      <text wx:if="{{item.description}}" class="muted field-description">{{item.description}}</text>
      <input wx:if="{{item.type === 'short_text'}}" class="input" value="{{fieldValues[item.fieldKey]}}" data-fieldkey="{{item.fieldKey}}" bindinput="onFieldInput" />
      <textarea wx:elif="{{item.type === 'long_text'}}" class="textarea" value="{{fieldValues[item.fieldKey]}}" data-fieldkey="{{item.fieldKey}}" bindinput="onFieldInput" />
      <input wx:elif="{{item.type === 'number'}}" class="input" type="digit" value="{{fieldValues[item.fieldKey]}}" data-fieldkey="{{item.fieldKey}}" bindinput="onNumberInput" />
      <radio-group wx:elif="{{item.type === 'boolean'}}" class="boolean-options" data-fieldkey="{{item.fieldKey}}" bindchange="onBooleanChange">
        <label><radio value="true" checked="{{fieldValues[item.fieldKey] === true}}" />是</label>
        <label><radio value="false" checked="{{fieldValues[item.fieldKey] === false}}" />否</label>
      </radio-group>
      <picker wx:elif="{{item.type === 'date'}}" mode="date" value="{{fieldValues[item.fieldKey]}}" data-fieldkey="{{item.fieldKey}}" bindchange="onDateChange">
        <view class="input">{{fieldValues[item.fieldKey] || '请选择日期'}}</view>
      </picker>
      <picker wx:elif="{{item.type === 'single_select'}}" mode="selector" range="{{item.constraints.options}}" data-fieldkey="{{item.fieldKey}}" bindchange="onSingleSelectChange">
        <view class="input">{{fieldValues[item.fieldKey] || '请选择'}}</view>
      </picker>
      <checkbox-group wx:elif="{{item.type === 'multi_select'}}" class="multi-options" data-fieldkey="{{item.fieldKey}}" bindchange="onMultiSelectChange">
        <label wx:for="{{item.optionItems}}" wx:for-item="option" wx:key="value">
          <checkbox value="{{option.value}}" checked="{{option.selected}}" />{{option.value}}
        </label>
      </checkbox-group>
    </view>

    <view class="field">
      <text class="field-label">进度说明</text>
      <textarea class="textarea" value="{{comment}}" bindinput="onComment" placeholder="说明已完成事项、存在问题或下一步安排" />
    </view>
    <view class="field">
      <view class="row-between">
        <text class="field-label">节点凭证{{requiresEvidence ? ' *' : ''}}</text>
        <text class="muted">合计 {{selectedTotalText}} / 20 MB</text>
      </view>
      <view class="evidence-actions">
        <button size="mini" class="secondary-button" bindtap="chooseMediaEvidence">选择图片或视频</button>
        <button size="mini" class="secondary-button" bindtap="choosePdfEvidence">选择 PDF</button>
      </view>
      <view class="local-file" wx:for="{{files}}" wx:key="localKey">
        <view class="local-file-main">
          <text class="file-name">{{item.name}}</text>
          <text class="muted">{{item.sizeText || item.size}} · {{item.statusLabel || item.status}}</text>
          <text wx:if="{{item.errorMessage}}" class="error-text">{{item.errorMessage}}</text>
        </view>
        <text wx:if="{{item.status !== 'uploading'}}" class="remove" data-index="{{index}}" bindtap="removeFile">移除</text>
      </view>
    </view>
    <button class="primary-button" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交反馈</button>
  </view>

  <view class="card" wx:elif="{{!loadingHistory}}">
    <text class="muted">你可以查看节点记录与凭证，但当前账号不能提交此节点。</text>
  </view>

  <view class="section-title">反馈历史</view>
  <view class="card history" wx:for="{{history}}" wx:key="feedbackId">
    <view class="row-between">
      <text class="history-status">{{item.statusLabel}} · 第 {{item.revision || 1}} 版</text>
      <text class="muted">{{item.submittedAtText}}</text>
    </view>
    <view class="history-fields" wx:if="{{item.fieldValues.length}}">
      <view class="history-field" wx:for="{{item.fieldValues}}" wx:for-item="field" wx:key="fieldKey">
        <text class="muted">{{field.name}}</text><text>{{field.valueText}}</text>
      </view>
    </view>
    <text class="history-comment">{{item.comment || '未填写说明'}}</text>
    <view class="history-evidence" wx:for="{{item.evidences}}" wx:for-item="evidence" wx:key="evidenceId" data-evidenceid="{{evidence.evidenceId}}" data-category="{{evidence.category}}" data-status="{{evidence.storageStatus}}" bindtap="previewEvidence">
      <text class="file-name">{{evidence.fileName}}</text>
      <text class="muted">{{evidence.storageStatusLabel}}{{evidence.storageStatus === 'purged' ? '（已清理）' : evidence.canPreview ? ' · 查看' : ''}}</text>
    </view>
  </view>
  <view class="empty" wx:if="{{!loadingHistory && !history.length}}">暂无反馈记录</view>

  <button wx:if="{{history.length}}" class="secondary-button download-all" bindtap="downloadAllEvidence" loading="{{downloading}}" disabled="{{downloading}}">顺序下载可用凭证</button>

  <view wx:if="{{videoPreview}}" class="video-mask">
    <view class="video-panel">
      <view class="row-between"><text>{{videoPreview.fileName}}</text><text class="remove" bindtap="closeVideoPreview">关闭</text></view>
      <video class="video-player" src="{{videoPreview.url}}" controls autoplay />
    </view>
  </view>
</view>
