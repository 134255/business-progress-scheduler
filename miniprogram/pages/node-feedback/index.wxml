<view class="page">
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view wx:if="{{frozen}}" class="frozen-banner">售后已冻结，反馈历史和凭证保持只读。</view>

  <view class="card">
    <text class="muted">当前节点 {{nodeCode}}</text>
    <view class="title node-title">{{nodeName}}</view>
    <view wx:if="{{workflowMode === 'review'}}" class="review-summary">
      <text class="muted block">处理人：{{processorNamesText || '未配置'}}</text>
      <text class="muted block">审核人：{{reviewerNamesText || '未配置'}}（{{reviewModeLabel}}）</text>
      <text class="muted block">处理轮次：{{processingRoundNumber}} · 审核轮次：{{reviewRoundNumber}}</text>
      <text class="muted block">处理截止：{{processingDueText}}</text>
      <text wx:if="{{reviewStartedText}}" class="muted block">提交审核：{{reviewStartedText}}</text>
      <text class="muted block">审核截止：{{reviewDueText}}</text>
    </view>
  </view>

  <view wx:if="{{canSubmit || workflowMode === 'review'}}" class="card">
    <view wx:if="{{legacyMode}}" class="field">
      <text class="field-label">节点状态</text>
      <picker mode="selector" disabled="{{submitting || readOnly}}" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatus">
        <view class="input">{{statusOptions[statusIndex].label}}</view>
      </picker>
    </view>

    <view wx:if="{{workflowMode === 'review' && !readOnly && !reviewDraftLocked}}" class="recognition-panel">
      <text class="field-label">粘贴文本智能填充</text>
      <text class="muted field-description">粘贴微信或其他来源的文本，识别结果仅作预填，应用前可逐项确认。</text>
      <textarea class="textarea recognition-text" maxlength="8000" disabled="{{recognizing || submitting}}" value="{{recognitionText}}" bindinput="onRecognitionText" placeholder="请粘贴需要识别的文本" />
      <button class="secondary-button" bindtap="onRecognizeText" loading="{{recognizing}}" disabled="{{recognizing || submitting || !recognitionText}}">识别字段</button>
      <button wx:if="{{recognizing}}" class="secondary-button" bindtap="onCancelRecognition">取消识别</button>
      <view wx:if="{{recognitionCandidates.length}}" class="recognition-preview">
        <view class="recognition-candidate" wx:for="{{recognitionCandidates}}" wx:key="fieldKey">
          <checkbox-group data-index="{{index}}" bindchange="onRecognitionCandidateToggle">
            <label><checkbox value="selected" checked="{{item.selected}}" />{{item.fieldName}}</label>
          </checkbox-group>
          <text class="muted block">当前：{{item.currentText}}</text>
          <text class="block">建议：{{item.candidateText}}（{{item.confidenceText}}）</text>
          <text class="muted block">依据：{{item.sourceExcerpt}}</text>
          <text wx:if="{{item.group === 'replacement'}}" class="recognition-warning">已有内容，勾选后才会替换</text>
          <text wx:if="{{item.group === 'manual'}}" class="recognition-warning">匹配存在歧义，请人工确认</text>
        </view>
        <button class="primary-button" bindtap="onApplyRecognitionCandidates" disabled="{{recognizing || submitting}}">应用选中结果</button>
      </view>
    </view>

    <view class="field dynamic-field" wx:for="{{fields}}" wx:key="fieldKey">
      <text class="field-label">{{item.name}}{{item.required ? ' *' : ''}}</text>
      <text wx:if="{{item.description}}" class="muted field-description">{{item.description}}</text>
      <input wx:if="{{item.type === 'short_text'}}" class="input" disabled="{{readOnly || reviewDraftLocked || submitting}}" value="{{fieldValues[item.fieldKey]}}" data-fieldkey="{{item.fieldKey}}" bindinput="onFieldInput" />
      <textarea wx:elif="{{item.type === 'long_text'}}" class="textarea" disabled="{{readOnly || reviewDraftLocked || submitting}}" value="{{fieldValues[item.fieldKey]}}" data-fieldkey="{{item.fieldKey}}" bindinput="onFieldInput" />
      <input wx:elif="{{item.type === 'number'}}" class="input" disabled="{{readOnly || reviewDraftLocked || submitting}}" type="digit" value="{{fieldValues[item.fieldKey]}}" data-fieldkey="{{item.fieldKey}}" bindinput="onNumberInput" />
      <radio-group wx:elif="{{item.type === 'boolean'}}" class="boolean-options" disabled="{{readOnly || reviewDraftLocked || submitting}}" data-fieldkey="{{item.fieldKey}}" bindchange="onBooleanChange">
        <label><radio value="true" checked="{{fieldValues[item.fieldKey] === true}}" />是</label>
        <label><radio value="false" checked="{{fieldValues[item.fieldKey] === false}}" />否</label>
      </radio-group>
      <picker wx:elif="{{item.type === 'date'}}" mode="date" disabled="{{readOnly || reviewDraftLocked || submitting}}" value="{{fieldValues[item.fieldKey]}}" data-fieldkey="{{item.fieldKey}}" bindchange="onDateChange">
        <view class="input">{{fieldValues[item.fieldKey] || '请选择日期'}}</view>
      </picker>
      <picker wx:elif="{{item.type === 'single_select'}}" mode="selector" disabled="{{readOnly || reviewDraftLocked || submitting}}" range="{{item.constraints.options}}" data-fieldkey="{{item.fieldKey}}" bindchange="onSingleSelectChange">
        <view class="input">{{fieldValues[item.fieldKey] || '请选择'}}</view>
      </picker>
      <checkbox-group wx:elif="{{item.type === 'multi_select'}}" class="multi-options" disabled="{{readOnly || reviewDraftLocked || submitting}}" data-fieldkey="{{item.fieldKey}}" bindchange="onMultiSelectChange">
        <label wx:for="{{item.optionItems}}" wx:for-item="option" wx:key="value">
          <checkbox value="{{option.value}}" checked="{{option.selected}}" />{{option.value}}
        </label>
      </checkbox-group>
    </view>

    <view class="field">
      <text class="field-label">进度说明</text>
      <textarea class="textarea" disabled="{{readOnly || reviewDraftLocked || submitting}}" value="{{comment}}" bindinput="onComment" placeholder="说明已完成事项、存在问题或下一步安排" />
    </view>
    <view class="field">
      <view class="row-between">
        <text class="field-label">节点凭证{{requiresEvidence ? ' *' : ''}}</text>
        <text class="muted">合计 {{selectedTotalText}} / 120 MB</text>
      </view>
      <view class="evidence-actions">
        <button size="mini" class="secondary-button" disabled="{{readOnly || reviewDraftLocked || submitting}}" bindtap="chooseMediaEvidence">选择图片或视频</button>
        <button size="mini" class="secondary-button" disabled="{{readOnly || reviewDraftLocked || submitting}}" bindtap="choosePdfEvidence">选择 PDF</button>
      </view>
      <view wx:if="{{submitting && files.length}}" class="muted">本轮上传进度 {{uploadProgressPercent}}%</view>
      <view class="local-file" wx:for="{{files}}" wx:key="localKey">
        <view class="local-file-main">
          <text class="file-name">{{item.name}}</text>
          <text class="muted">{{item.sizeText || item.size}} · {{item.statusLabel || item.status}}</text>
          <text wx:if="{{item.errorMessage}}" class="error-text">{{item.errorMessage}}</text>
        </view>
        <text wx:if="{{!readOnly && !reviewDraftLocked && !submitting && item.status !== 'uploading'}}" class="remove" data-index="{{index}}" bindtap="removeFile">移除</text>
      </view>
    </view>
    <button wx:if="{{legacyMode}}" class="primary-button" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || readOnly}}">提交反馈</button>
    <view wx:else class="review-actions">
      <button class="secondary-button" bindtap="onSaveProgress" loading="{{submitting}}" disabled="{{submitting || readOnly || reviewDraftLocked}}">保存处理进度</button>
      <button class="secondary-button" bindtap="onMarkBlocked" loading="{{submitting}}" disabled="{{submitting || readOnly || reviewDraftLocked}}">标记受阻</button>
      <button wx:if="{{requiresReview}}" class="primary-button" bindtap="onPrimaryAction" loading="{{submitting}}" disabled="{{submitting || readOnly}}">提交审核</button>
      <button wx:else class="primary-button" bindtap="onPrimaryAction" loading="{{submitting}}" disabled="{{submitting || readOnly}}">完成节点</button>
      <text wx:if="{{requiresReview && reviewDraftLocked && !readOnly}}" class="muted readonly-tip">处理草稿已保存，内容已锁定；可再次点击提交审核继续重试。</text>
      <text wx:if="{{readOnly}}" class="muted readonly-tip">当前节点不可编辑，审核结果以服务端最新状态为准。</text>
    </view>
  </view>

  <view class="card" wx:elif="{{!loadingHistory}}">
    <text class="muted">你可以查看节点记录与凭证，但当前账号不能提交此节点。</text>
  </view>

  <view class="section-title">反馈历史</view>
  <view class="card history" wx:for="{{history}}" wx:key="feedbackId">
    <view class="row-between">
      <text class="history-status">{{item.statusLabel}} · 第 {{item.revision || 1}} 版</text>
      <text class="muted">{{item.submittedAtText}}</text>
    </view>
    <view class="history-fields" wx:if="{{item.fieldValues.length}}">
      <view class="history-field" wx:for="{{item.fieldValues}}" wx:for-item="field" wx:key="fieldKey">
        <text class="muted">{{field.name}}</text><text>{{field.valueText}}</text>
      </view>
    </view>
    <text class="history-comment">{{item.comment || '未填写说明'}}</text>
    <view class="history-evidence" wx:for="{{item.evidences}}" wx:for-item="evidence" wx:key="evidenceId" data-evidenceid="{{evidence.evidenceId}}" data-category="{{evidence.category}}" data-status="{{evidence.storageStatus}}" data-filename="{{evidence.fileName}}" bindtap="previewEvidence">
      <text class="file-name">{{evidence.fileName}}</text>
      <text class="muted">{{evidence.storageStatusLabel}}{{evidence.storageStatus === 'purged' ? '（已清理）' : evidence.canPreview ? (evidence.downloadOnly ? ' · 下载' : ' · 查看') : ''}}</text>
    </view>
  </view>
  <view class="empty" wx:if="{{!loadingHistory && !history.length}}">暂无反馈记录</view>

  <button wx:if="{{history.length}}" class="secondary-button download-all" bindtap="downloadAllEvidence" loading="{{downloading}}" disabled="{{downloading}}">顺序下载可用凭证</button>

  <view wx:if="{{videoPreview}}" class="video-mask">
    <view class="video-panel">
      <view class="row-between"><text>{{videoPreview.fileName}}</text><text class="remove" bindtap="closeVideoPreview">关闭</text></view>
      <video class="video-player" src="{{videoPreview.url}}" controls autoplay />
    </view>
  </view>
</view>
