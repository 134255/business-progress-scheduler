<view class="page">
  <view class="card toolbar">
    <view class="search-row">
      <input class="input search-input" value="{{keyword}}" placeholder="搜索模板名称或说明" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search" />
      <button class="primary-button search-button" bindtap="search" loading="{{loading}}">搜索</button>
    </view>
    <view class="filter-row row-between">
      <picker range="{{['全部状态', '草稿', '已启用', '已停用']}}" value="{{status === 'draft' ? 1 : status === 'enabled' ? 2 : status === 'disabled' ? 3 : 0}}" bindchange="onStatusChange">
        <view class="filter">状态：{{status === 'draft' ? '草稿' : status === 'enabled' ? '已启用' : status === 'disabled' ? '已停用' : '全部'}}</view>
      </picker>
      <button class="secondary-button create-button" bindtap="openCreate">新建模板</button>
    </view>
  </view>
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view wx:if="{{items.length}}">
    <view class="card template-card" wx:for="{{items}}" wx:key="_id">
      <view class="row-between">
        <view><view class="template-name">{{item.name}}</view><text class="muted">{{item.description || '暂无说明'}}</text></view>
        <text class="status {{item.status}}">{{item.status === 'draft' ? '草稿' : item.status === 'enabled' ? '已启用' : '已停用'}}</text>
      </view>
      <view class="meta">节点 {{item.nodeCount || 0}} 个 · 版本 {{item.version}}</view>
      <view class="actions">
        <button size="mini" data-id="{{item._id}}" bindtap="openEdit">{{item.status === 'enabled' ? '查看' : '编辑'}}</button>
        <button size="mini" class="secondary-button" data-id="{{item._id}}" bindtap="changeStatus">{{item.status === 'enabled' ? '停用' : '启用'}}</button>
        <button wx:if="{{item.status !== 'enabled'}}" size="mini" class="danger-button" data-id="{{item._id}}" bindtap="deleteTemplate">删除</button>
      </view>
    </view>
  </view>
  <view class="empty" wx:else>{{loading ? '加载中…' : '暂无模板'}}</view>
</view>
