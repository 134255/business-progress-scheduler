<view class="page">
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view wx:if="{{loading}}" class="empty">正在加载审核详情…</view>
  <view wx:else>
    <view class="card">
      <view class="row-between"><view class="title detail-title">{{businessName}}</view><text class="mode">{{reviewModeLabel}}</text></view>
      <text class="muted block">售后编号：{{businessCode}}</text>
      <text class="block">{{nodeName}}（{{nodeCode}}）</text>
      <text class="muted block">第 {{reviewRoundNumber}} 轮审核 · 投票 {{voteProgressText}}</text>
      <text class="muted block">处理人：{{processorNamesText || '未配置'}}</text>
      <text class="muted block">审核人：{{reviewerNamesText || '未配置'}}</text>
      <text class="muted block">提交时间：{{submittedAtText || '待记录'}}</text>
      <text class="due block">审核截止：{{dueText}}</text>
    </view>

    <previous-node-records business-line-id="{{businessLineId}}" node-id="{{nodeId}}" enabled="{{previousRecordsEnabled}}" return-label="返回当前审核" bindreturntocurrent="returnToCurrentForm" />
    <view id="current-node-form" />

    <view class="card compact-card">
      <view class="compact-heading">本轮提交内容</view>
      <view class="compact-fields">
        <view class="compact-field" wx:for="{{fields}}" wx:key="fieldKey">
          <text class="compact-label">{{item.name}}</text><text class="compact-value" user-select="true">{{item.valueText}}</text>
        </view>
        <view class="compact-field"><text class="compact-label">处理说明</text><text class="compact-value" user-select="true">{{processingCommentText}}</text></view>
      </view>
      <text wx:if="{{!fields.length}}" class="muted block">本轮没有字段内容</text>
    </view>

    <view class="card compact-card">
      <view class="compact-heading">节点凭证（{{evidences.length}}）</view>
      <view class="evidence-row" wx:for="{{evidences}}" wx:key="evidenceId" data-id="{{item.evidenceId}}" bindtap="previewEvidence">
        <text class="evidence-name">{{item.fileName || '凭证 ' + item.sequence}}</text><text class="action">{{item.storageStatus === 'purged' ? '已清理' : '查看 / 下载 →'}}</text>
      </view>
      <text wx:if="{{!evidences.length}}" class="muted block">本轮没有凭证</text>
    </view>

    <button class="compact-toggle" bindtap="onToggleVotes"><text>审核记录（{{votes.length}}）</text><text class="fold-indicator">{{votesOpen ? '收起 ▴' : '展开 ▾'}}</text></button>
    <view wx:if="{{votesOpen}}" class="card compact-card">
    <view class="vote-row" wx:for="{{votes}}" wx:key="voteKey">
      <view class="row-between"><text>{{item.reviewerDisplayName}}</text><text>{{item.decisionLabel}}</text></view>
      <text class="muted block">{{item.createdAtText}}</text>
      <text class="block vote-comment">{{item.commentText}}</text>
    </view>
    <text wx:if="{{!votes.length}}" class="muted block">本轮暂无审核意见</text>
    </view>

    <view wx:if="{{status === 'pending' && (canApprove || canReject)}}" class="card operation-card">
      <textarea class="textarea" value="{{comment}}" maxlength="1000" bindinput="onComment" placeholder="通过意见可不填；驳回时必须填写原因" disabled="{{submitting}}" />
      <view class="actions">
        <button class="secondary-button" bindtap="onReject" loading="{{submitting}}" disabled="{{submitting || !canReject}}">驳回</button>
        <button class="primary-button" bindtap="onApprove" loading="{{submitting}}" disabled="{{submitting || !canApprove}}">通过</button>
      </view>
    </view>
    <view wx:else class="card"><text class="muted">本轮审核已结束或你已提交意见，页面内容只读。</text></view>
  </view>

  <view wx:if="{{videoPreview}}" class="video-mask">
    <view class="video-panel">
      <view class="row-between"><text>{{videoPreview.fileName}}</text><text class="close" bindtap="closeVideoPreview">关闭</text></view>
      <video class="video-player" src="{{videoPreview.url}}" controls autoplay />
    </view>
  </view>
</view>
