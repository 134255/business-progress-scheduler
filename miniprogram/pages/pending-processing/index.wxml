<import src="../../templates/business-card.wxml" />
<view class="page">
  <view class="section-title">待我处理</view>
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}<button size="mini" bindtap="retryCards" disabled="{{loading || loadingMore}}">重试</button></view>
  <view class="card task-card" wx:for="{{items}}" wx:key="nodeId" data-line-id="{{item.businessLineId}}" data-node-id="{{item.nodeId}}" bindtap="openItem">
    <template is="business-card" data="{{item}}" />
    <text class="block">{{item.nodeName}} · 第 {{item.processingRoundNumber}} 轮处理</text>
    <text class="muted block">{{item.nodeCode}}</text>
    <text class="due block">{{item.dueText}}</text>
    <text class="action block">{{item.actionText}}</text>
  </view>
  <view wx:if="{{!loading && !errorMessage && !items.length}}" class="empty">暂无待我处理事项</view>
  <view wx:if="{{loading}}" class="empty">正在加载待处理事项…</view>
  <button wx:if="{{hasMore}}" class="secondary-button" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
</view>
