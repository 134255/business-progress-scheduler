@import "../../templates/business-card.wxss";
.date-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.date-row picker { flex: 1; }
.date-box { padding: 20rpx; border: 1rpx solid #d1d5db; border-radius: 12rpx; background: #f9fafb; }
.create { margin-bottom: 24rpx; }
.block { display: block; margin-top: 12rpx; }
.load-more { padding: 20rpx 0 40rpx; text-align: center; color: #9ca3af; }
.search-help { display: block; margin-top: 12rpx; color: #6b7280; font-size: 24rpx; line-height: 1.5; }
.filter-scope { margin-bottom: 20rpx; color: #0f766e; font-size: 28rpx; font-weight: 600; }
.search-error { margin: 20rpx 0; padding: 24rpx; color: #b91c1c; background: #fef2f2; border-radius: 12rpx; line-height: 1.6; }
.search-pending { padding: 24rpx; color: #6b7280; text-align: center; }
.search-matches { margin-top: 18rpx; padding-top: 14rpx; border-top: 1rpx solid #e5e7eb; }
.search-match { padding: 12rpx 14rpx; margin-top: 10rpx; border-radius: 10rpx; background: #f0fdfa; }
.search-match-label { display: block; color: #0f766e; font-size: 24rpx; font-weight: 600; }
.search-match-excerpt { display: block; margin-top: 6rpx; color: #374151; font-size: 26rpx; line-height: 1.5; word-break: break-all; }
.match-toggle { margin: 12rpx 0 0; padding: 0; border: 0; background: transparent; color: #0f766e; font-size: 24rpx; line-height: 1.8; text-align: left; }
.match-toggle::after { border: 0; }
