<view class="page">
  <view class="card">
    <view class="field">
      <text class="field-label">检索内容</text>
      <input class="input" value="{{keyword}}" placeholder="输入售后、节点、字段或凭证名称" bindinput="onKeyword" confirm-type="search" bindconfirm="search" />
      <text class="search-help">可检索售后、节点、字段和凭证名称；仅返回你有权查看的售后</text>
    </view>
    <view class="date-row">
      <picker mode="date" value="{{startDate}}" bindchange="onStartDate"><view class="date-box">{{startDate || '开始日期'}}</view></picker>
      <text class="muted">至</text>
      <picker mode="date" value="{{endDate}}" bindchange="onEndDate"><view class="date-box">{{endDate || '结束日期'}}</view></picker>
    </view>
    <button class="primary-button" bindtap="search" loading="{{loading}}">检索</button>
  </view>

  <button class="secondary-button create" bindtap="createBusiness">+ 新建售后线</button>

  <view class="card" wx:for="{{items}}" wx:key="_id" data-id="{{item._id}}" bindtap="openDetail">
    <view class="row-between"><text class="name">{{item.name}}</text><status-pill status="{{item.status}}" /></view>
    <text class="muted block">{{item.code}} · {{item.plannedStartDate || '未设开始日期'}}</text>
    <text class="muted block">当前节点：{{item.currentNodeName || '待配置'}}</text>
    <view class="search-matches" wx:if="{{item.matches.length}}">
      <view class="search-match" wx:for="{{item.visibleMatches}}" wx:for-item="match" wx:key="id">
        <text class="search-match-label">{{match.nodeName}} · {{match.label}}</text>
        <text class="search-match-excerpt">{{match.excerpt}}</text>
      </view>
      <button class="match-toggle" wx:if="{{item.hasHiddenMatches}}" catchtap="toggleMatches" data-id="{{item._id}}">
        {{item.matchesExpanded ? '收起命中内容' : '展开全部 ' + item.matches.length + ' 条命中'}}
      </button>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && !items.length}}">没有匹配的售后</view>
  <view class="load-more" wx:if="{{items.length}}">{{loading ? '加载中…' : loadMoreText}}</view>
</view>
