<view class="page initialize-page">
  <view class="card initialize-card">
    <view class="title">初始化首位超级管理员</view>
    <text class="muted intro">此操作只能成功一次。请使用纸质恢复码，并在完成后立即设置正式密码。</text>

    <view class="checking" wx:if="{{checking}}">正在核对初始化状态…</view>

    <block wx:else>
      <view class="error" wx:if="{{errorMessage}}">{{errorMessage}}</view>

      <block wx:if="{{available}}">
        <view class="field">
          <label class="field-label" for="username">管理员用户名</label>
          <input
            id="username"
            class="input"
            value="{{username}}"
            maxlength="64"
            placeholder="请输入唯一用户名"
            bindinput="onUsernameInput"
          />
        </view>

        <view class="field">
          <label class="field-label" for="display-name">显示名称</label>
          <input
            id="display-name"
            class="input"
            value="{{displayName}}"
            maxlength="30"
            placeholder="请输入管理员显示名称"
            bindinput="onDisplayNameInput"
          />
        </view>

        <view class="field">
          <label class="field-label" for="temporary-password">临时密码</label>
          <input
            id="temporary-password"
            class="input"
            value="{{temporaryPassword}}"
            password="true"
            maxlength="64"
            placeholder="8-64 位，至少包含字母和数字"
            bindinput="onTemporaryPasswordInput"
          />
        </view>

        <view class="field">
          <label class="field-label" for="confirm-password">确认临时密码</label>
          <input
            id="confirm-password"
            class="input"
            value="{{confirmPassword}}"
            password="true"
            maxlength="64"
            placeholder="请再次输入临时密码"
            bindinput="onConfirmPasswordInput"
          />
        </view>

        <view class="field">
          <label class="field-label" for="recovery-code">纸质恢复码</label>
          <input
            id="recovery-code"
            class="input recovery-input"
            value="{{recoveryCode}}"
            password="true"
            maxlength="128"
            placeholder="请按纸质记录输入"
            bindinput="onRecoveryCodeInput"
            confirm-type="done"
            bindconfirm="submit"
          />
          <text class="hint">恢复码成功使用后立即失效，不要截图或保存到设备。</text>
        </view>

        <button
          class="primary-button submit"
          loading="{{submitting}}"
          disabled="{{submitting || checking || !available}}"
          bindtap="submit"
        >创建并设置正式密码</button>
      </block>
    </block>
  </view>
</view>
