<view class="page">
  <view class="section-title">运营看板</view>
  <view class="card filters">
    <view class="row-between"><text>开始日期</text><picker mode="date" value="{{startDate}}" bindchange="onStartDateChange"><text>{{startDate}}</text></picker></view>
    <view class="row-between"><text>结束日期</text><picker mode="date" value="{{endDate}}" bindchange="onEndDateChange"><text>{{endDate}}</text></picker></view>
    <view class="row-between"><text>业务状态</text><picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange"><text>{{statusOptions[statusIndex].label}}</text></picker></view>
    <button class="secondary-button" bindtap="applyRange" disabled="{{loading}}" loading="{{loading}}">应用日期范围</button>
  </view>
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view class="metrics">
    <view class="card metric"><text class="value">{{stats.businesses || 0}}</text><text>业务总数</text></view>
    <view class="card metric"><text class="value">{{stats.active || 0}}</text><text>进行中</text></view>
    <view class="card metric"><text class="value">{{stats.completed || 0}}</text><text>已完成</text></view>
    <view class="card metric"><text class="value">{{stats.frozen || 0}}</text><text>其他冻结终态</text></view>
    <view class="card metric"><text class="value">{{stats.pendingProcessing || 0}}</text><text>待处理</text></view>
    <view class="card metric"><text class="value">{{stats.pendingReview || 0}}</text><text>待审核</text></view>
    <view class="card metric"><text class="value">{{stats.overdueProcessing || 0}}</text><text>处理逾期</text></view>
    <view class="card metric"><text class="value">{{stats.overdueReview || 0}}</text><text>审核逾期</text></view>
    <view class="card metric"><text class="value">{{stats.pendingCalendar || 0}}</text><text>日历待补算</text></view>
  </view>
  <button class="primary-button" bindtap="exportCsv" loading="{{exporting}}" disabled="{{exporting}}">导出 CSV</button>

  <view class="section-title timing-title">节点处理时间明细</view>
  <view wx:if="{{timingError}}" class="error">{{timingError}}</view>
  <view wx:if="{{timingLoading && !timingItems.length}}" class="empty">正在加载个人工时明细…</view>
  <view wx:elif="{{!timingItems.length && !timingError}}" class="empty">当前范围暂无个人工时记录</view>
  <view wx:else>
    <view class="card timing-card" wx:for="{{timingItems}}" wx:key="roundId">
      <view class="row-between timing-heading">
        <view>
          <view class="timing-business">{{item.businessCode}} · {{item.businessName}}</view>
          <view class="muted">{{item.nodeCode}} · {{item.nodeName}}</view>
        </view>
        <button class="link-button" size="mini" data-round-id="{{item.roundId}}" bindtap="toggleTimingDetail">{{item.expanded ? '收起' : '展开'}}</button>
      </view>
      <view class="timing-line">处理轮次 {{item.processingRoundNumber}} · 审核轮次 {{item.reviewRoundNumber}}</view>
      <view class="timing-line">实际提交人：{{item.submittedByDisplayName}}</view>
      <view class="timing-line">负责人来源：{{item.assignmentModeLabel}}</view>
      <view class="timing-line">本轮处理：{{item.processingTimingLabel}}</view>
      <view class="timing-line">本轮提交审核：{{item.reviewStartedAtLabel}}</view>
      <view wx:if="{{item.expanded}}" class="timing-detail">
        <view class="timing-line">提交时累计逾期：{{item.processingOverdueLabel}}</view>
        <view wx:if="{{!item.votes.length}}" class="muted">本轮尚无实际投票记录</view>
        <view class="vote-row" wx:for="{{item.votes}}" wx:for-item="vote" wx:key="voteKey">
          <view>{{vote.reviewerDisplayName}} · {{vote.decisionLabel}}</view>
          <view class="muted">响应工时：{{vote.responseTimingLabel}}</view>
          <view class="muted">投票时间：{{vote.votedAtLabel}}</view>
        </view>
      </view>
    </view>
    <button wx:if="{{timingHasMore}}" class="secondary-button" bindtap="loadMoreTiming" loading="{{timingLoadingMore}}" disabled="{{timingLoadingMore}}">加载更多</button>
  </view>
</view>
