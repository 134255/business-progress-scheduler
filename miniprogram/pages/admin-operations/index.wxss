.filters { margin-bottom: 24rpx; }
.filter-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-bottom: 1rpx solid #edf2f2; }
.inline-picker { display: inline-block; }
.advanced-link { color: #0f766e; font-weight: 600; padding: 18rpx 0; }
.advanced-box { padding: 0 12rpx; background: #f7fbfa; border-radius: 14rpx; }
.notice { margin: 18rpx 0; padding: 18rpx; color: #47605d; background: #ecfdf5; border-radius: 14rpx; font-size: 24rpx; }
.card-title { color: #1f2937; font-size: 28rpx; font-weight: 700; margin-bottom: 18rpx; }
.current-card { margin-bottom: 20rpx; }
.current-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.current-grid view { padding: 16rpx 8rpx; text-align: center; background: #f7fbfa; border-radius: 12rpx; }
.current-grid text { display: block; font-size: 22rpx; color: #64748b; }
.current-grid text:first-child { color: #0f766e; font-size: 30rpx; font-weight: 700; }
.metric-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.metric-card { margin: 0; padding: 20rpx 12rpx; text-align: center; font-size: 22rpx; }
.metric-value { display: block; color: #0f766e; font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.node-chart-scroll { width: 100%; white-space: nowrap; }
.node-chart-strip { display: inline-flex; gap: 16rpx; padding: 4rpx 4rpx 16rpx; }
.node-chart-card { display: inline-block; width: 620rpx; margin: 0; box-sizing: border-box; white-space: normal; }
.chart-card, .trend-chart { margin-bottom: 16rpx; }
.node-title { color: #1f2937; font-weight: 700; }
.bar-row { display: grid; grid-template-columns: 64rpx 1fr 150rpx; gap: 12rpx; align-items: center; margin-top: 20rpx; }
.bar-label, .bar-value { font-size: 24rpx; color: #4b5563; }
.bar-value { text-align: right; }
.bar-track { height: 24rpx; background: #e5e7eb; border-radius: 999rpx; overflow: hidden; }
.bar { height: 100%; border-radius: 999rpx; }
.processing-bar { background: #14b8a6; }
.review-bar { background: #f59e0b; }
.sample-note { margin-top: 16rpx; font-size: 22rpx; color: #6b7280; }
.sample-heading { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.sample-panel { margin-top: 24rpx; }
.statistics { color: #4b5563; font-size: 24rpx; line-height: 1.7; }
.sample-row { padding: 18rpx 0; border-bottom: 1rpx solid #e5e7eb; color: #4b5563; }
.round-list { margin-top: 12rpx; padding: 12rpx; background: #f8fafc; border-radius: 12rpx; }
.round-row { padding: 10rpx 0; border-bottom: 1rpx solid #e5e7eb; font-size: 22rpx; line-height: 1.6; }
.round-row:last-child { border-bottom: 0; }
