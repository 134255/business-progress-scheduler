.filters .row-between { padding: 16rpx 0; }
.metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin: 20rpx 0; }
.metric { display: flex; flex-direction: column; align-items: center; margin: 0; }
.value { font-size: 44rpx; font-weight: 700; color: #0f766e; }
.timing-title { margin-top: 36rpx; }
.timing-card { margin-bottom: 18rpx; }
.timing-heading { align-items: flex-start; gap: 16rpx; }
.timing-business { font-weight: 700; color: #1f2937; }
.timing-line { margin-top: 10rpx; color: #374151; line-height: 1.55; }
.timing-detail { margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid #e5e7eb; }
.vote-row { margin-top: 14rpx; padding: 14rpx; border-radius: 12rpx; background: #f8fafc; }
.muted { color: #6b7280; font-size: 26rpx; }
.link-button { margin: 0; color: #0f766e; background: transparent; padding: 0 12rpx; }
