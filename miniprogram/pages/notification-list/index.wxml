<view class="page">
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view class="card notice {{item.read ? 'read' : 'unread'}}" wx:for="{{items}}" wx:key="notificationId">
    <view class="notice-main" data-id="{{item.notificationId}}" bindtap="openNotification">
      <view class="row-between"><text class="notice-title">{{item.title}}</text><text wx:if="{{!item.read}}" class="dot">未读</text></view>
      <text class="muted block">{{item.createdAtText}}</text>
      <text class="action block">查看对应售后 →</text>
    </view>
    <button wx:if="{{!item.read}}" size="mini" class="secondary-button read-button" data-id="{{item.notificationId}}" catchtap="markReadOnly">标记已读</button>
  </view>
  <view wx:if="{{loading}}" class="empty">正在加载消息…</view>
  <view wx:if="{{!loading && !errorMessage && !items.length}}" class="empty">暂无消息通知</view>
  <button wx:if="{{hasMore}}" class="secondary-button" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
</view>
