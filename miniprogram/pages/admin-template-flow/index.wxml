<view class="page">
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view class="card flow-head">
    <view class="section-title">{{templateName}}</view>
    <text class="muted">只读预览来自服务器已保存的当前模板定义</text>
  </view>
  <view wx:if="{{diagnostics.length}}" class="diagnostics">
    <text wx:for="{{diagnostics}}" wx:key="*this">{{item}}</text>
  </view>
  <view class="flow-list" wx:if="{{rows.length}}">
    <view class="flow-row" wx:for="{{rows}}" wx:key="nodeKey">
      <view class="flow-marker">{{item.sequence}}</view>
      <view class="card flow-card">
        <view class="row-between">
          <text class="node-name">{{item.name}}</text>
          <text wx:if="{{item.isEntry}}" class="entry-badge">入口</text>
        </view>
        <text class="route-label">{{item.routeLabel}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="empty">暂无节点</view>
</view>
