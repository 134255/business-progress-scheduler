<view class="page" wx:if="{{line}}">
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view wx:if="{{frozen}}" class="frozen-banner">业务已冻结，普通信息、节点反馈和状态不可再修改。</view>
  <view class="card">
    <view class="row-between"><view class="title detail-title">{{line.name}}</view><status-pill status="{{line.status}}" /></view>
    <text class="muted block">编号：{{line.code}}</text>
    <text class="muted block">版本：{{line.version}}</text>
    <text class="muted block">{{line.description || '暂无说明'}}</text>
    <view class="progress"><view class="progress-value" style="width: {{line.progress || 0}}%"></view></view>
    <text class="muted">总体进度 {{line.progress || 0}}%</text>
    <button wx:if="{{canManage && !frozen}}" class="secondary-button edit-button" bindtap="editLine">编辑业务线</button>
    <button wx:if="{{showAmendmentEntry}}" class="secondary-button edit-button" bindtap="openAmendment">审计式修订</button>
  </view>

  <view class="section-title">节点进度</view>
  <view class="timeline">
    <view class="node card" wx:for="{{nodes}}" wx:key="_id" data-index="{{index}}" bindtap="openFeedback">
      <view class="node-index">{{index + 1}}</view>
      <view class="node-body">
        <view class="row-between"><text class="node-name">{{item.name}}</text><status-pill status="{{item.status}}" /></view>
        <text class="muted block">节点编号：{{item.nodeCode || '旧业务未编号'}}</text>
        <view wx:if="{{item.workflowMode === 'review'}}" class="review-node-meta">
          <text class="muted block">处理人：{{item.processorNamesText || '待分配'}}</text>
          <text class="muted block">审核人：{{item.reviewerNamesText || '待分配'}}（{{item.reviewModeLabel}}）</text>
          <text class="muted block">处理轮次：{{item.processingRoundNumber}} · 审核轮次：{{item.reviewRoundNumber}}</text>
          <text class="muted block">处理截止：{{item.processingDueText}} · {{item.processingOverdueText}}</text>
          <text wx:if="{{item.reviewStartedText}}" class="muted block">提交审核：{{item.reviewStartedText}}</text>
          <text class="muted block">审核截止：{{item.reviewDueText}} · {{item.reviewOverdueText}}</text>
        </view>
        <text wx:else class="muted block">负责人：{{item.assigneeNamesText || '待分配'}}</text>
        <text class="muted block" wx:if="{{item.requiresEvidence}}">需上传凭证</text>
        <text class="action-tip">{{item.canFeedback ? '反馈进度并查看凭证' : '查看节点记录与凭证'}} →</text>
      </view>
    </view>
  </view>

  <view wx:if="{{canRejectPrevious}}" class="card operation-card">
    <view class="section-title compact-title">驳回上一节点</view>
    <text class="muted block">仅可驳回紧邻的“{{previousNode.name}}”，原反馈与凭证不会被删除。</text>
    <textarea class="textarea" value="{{rejectionReason}}" maxlength="500" bindinput="onRejectionReason" placeholder="请填写明确的驳回原因" />
    <button class="danger-button" bindtap="rejectPrevious" loading="{{rejecting}}" disabled="{{rejecting}}">确认驳回</button>
  </view>

  <view wx:if="{{canClose}}" class="card operation-card">
    <view class="section-title compact-title">结束业务</view>
    <picker mode="selector" range="{{closureOptions}}" range-key="label" value="{{closureIndex}}" bindchange="onClosureOutcome">
      <view class="input">{{closureOptions[closureIndex].label}}</view>
    </picker>
    <textarea class="textarea" value="{{closureReason}}" maxlength="500" bindinput="onClosureReason" placeholder="请填写取消、关闭或逻辑删除原因" />
    <button class="danger-button" bindtap="closeLine" loading="{{closing}}" disabled="{{closing}}">确认执行</button>
  </view>
</view>
<view class="empty" wx:else>{{loading ? '加载中…' : '业务线不存在或无权查看'}}</view>
