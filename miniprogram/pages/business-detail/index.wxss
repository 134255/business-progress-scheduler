.detail-title { max-width: 500rpx; }
.block { display: block; margin-top: 14rpx; }
.progress { height: 14rpx; margin: 28rpx 0 10rpx; background: #e5e7eb; border-radius: 999rpx; overflow: hidden; }
.progress-value { height: 100%; background: #14b8a6; }
.node { display: flex; gap: 20rpx; }
.node-index { width: 52rpx; height: 52rpx; line-height: 52rpx; border-radius: 50%; text-align: center; background: #ccfbf1; color: #0f766e; font-weight: 700; flex: none; }
.node-body { flex: 1; }
.node-name { font-weight: 650; }
.action-tip { display: block; margin-top: 18rpx; color: #0f766e; }
.edit-button { margin-top: 24rpx; }
.frozen-banner { margin-bottom: 20rpx; padding: 20rpx; border-radius: 14rpx; color: #92400e; background: #fffbeb; }
.operation-card { margin-top: 24rpx; }
.compact-title { margin: 0 0 12rpx; }
.operation-card .textarea, .operation-card .input { margin: 18rpx 0; }
.review-node-meta { margin-top: 12rpx; padding: 12rpx; border-radius: 12rpx; background: #f8fafc; }
.optional-summary { display: block; margin-top: 14rpx; color: #0f766e; font-weight: 650; }
.optional-actions { margin-top: 18rpx; }
.optional-actions button { margin-top: 12rpx; }
.optional-decision-panel { border: 2rpx solid #99f6e4; }
.decision-confirm-actions { display: flex; gap: 18rpx; margin-top: 18rpx; }
.decision-confirm-actions button { flex: 1; }
.route-progress-summary { display: block; margin-top: 24rpx; color: #0f766e; font-weight: 650; }
.route-actions { padding-top: 8rpx; border-top: 1rpx solid #ccfbf1; }
