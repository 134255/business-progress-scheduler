<view class="page">
  <view class="hero card">
    <view class="row-between">
      <text class="muted">你好{{profile && profile.displayName ? '，' + profile.displayName : ''}}</text>
      <text class="profile-link" bindtap="openProfile">个人资料</text>
    </view>
    <view class="title">让每条售后都有清晰的记录</view>
    <view class="hero-actions">
      <button class="primary-button action" bindtap="createBusiness">新建售后线</button>
      <button class="secondary-button action" bindtap="openList">查看全部</button>
    </view>
  </view>

  <view class="stats">
    <view class="stat card"><text class="stat-value">{{stats.active}}</text><text class="muted">进行中</text></view>
    <view class="stat card" bindtap="openPendingProcessing"><text class="stat-value">{{stats.pendingMine}}</text><text class="muted">待我处理</text></view>
    <view class="stat card"><text class="stat-value">{{stats.completed}}</text><text class="muted">已完成</text></view>
  </view>

  <view class="quick-actions">
    <view class="card quick-action" bindtap="openReviews">
      <text class="quick-value">{{stats.pendingReviews || 0}}</text>
      <text>待我审核</text>
    </view>
    <view class="card quick-action" bindtap="openNotifications">
      <text class="quick-value">{{stats.unreadNotifications || 0}}</text>
      <text>消息通知</text>
    </view>
  </view>

  <view class="row-between section-head">
    <view class="section-title">最近售后</view>
    <view class="admin-links">
      <text wx:if="{{profile && profile.role === 'super_admin'}}" class="link" bindtap="openAdminUsers">用户管理</text>
      <text wx:if="{{profile && profile.status === 'active'}}" class="link" bindtap="openAdminOperations">运营看板</text>
      <text wx:if="{{profile && profile.role === 'super_admin'}}" class="link" bindtap="openAdminTemplates">模板管理</text>
      <text class="link" bindtap="openTemplates">可用模板</text>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="dashboard-error">{{errorMessage}}</view>

  <view wx:if="{{recent.length}}">
    <view class="card line-card" wx:for="{{recent}}" wx:key="_id" data-id="{{item._id}}" bindtap="openDetail">
      <view class="row-between">
        <text class="line-name">{{item.name}}</text>
        <status-pill status="{{item.status}}" />
      </view>
      <text class="muted">编号：{{item.code}}</text>
      <view wx:if="{{item.showProgressPercent}}" class="progress"><view class="progress-value" style="width: {{item.displayProgress || 0}}%"></view></view>
      <text wx:if="{{item.showProgressPercent}}" class="muted">当前节点：{{item.currentNodeName || '待配置'}}</text>
      <text wx:else class="muted">{{item.pathSummary}}</text>
    </view>
  </view>
  <view class="empty" wx:else>{{loading ? '加载中…' : '暂无售后线，先创建一条吧'}}</view>
</view>
