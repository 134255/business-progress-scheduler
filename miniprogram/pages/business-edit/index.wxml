<view class="page">
  <view class="empty" wx:if="{{loading}}">正在加载…</view>

  <view wx:else>
    <view wx:if="{{!editMode && templatePreview}}" class="card template-preview">
      <view class="row-between">
        <text class="preview-name">{{templatePreview.name}}</text>
        <text class="node-count">{{templatePreview.nodeCount}} 个节点</text>
      </view>
      <text class="muted block">{{templatePreview.description || '暂无模板说明'}}</text>
      <text wx:if="{{!templateAvailable}}" class="frozen-note">{{templatePreview.unavailableReason || '模板当前不可创建业务'}}</text>
    </view>

    <view wx:if="{{editMode}}" class="card immutable-summary">
      <text class="field-label">业务线编号</text>
      <text class="immutable-code">{{lineCode}}</text>
      <text class="muted block">编号和节点均由模板快照生成，不可编辑</text>
      <text wx:if="{{frozen}}" class="frozen-note">业务已完成或关闭，结构化信息已冻结</text>
    </view>

    <view class="card">
      <view class="field">
        <text class="field-label">业务线名称 *</text>
        <input class="input" disabled="{{editMode && (!canManage || frozen)}}" data-field="name" value="{{form.name}}" bindinput="updateField" placeholder="请输入业务线名称" />
      </view>
      <view class="field">
        <text class="field-label">说明</text>
        <textarea class="textarea" disabled="{{editMode && (!canManage || frozen)}}" data-field="description" value="{{form.description}}" bindinput="updateField" placeholder="补充业务背景、目标或特别要求" />
      </view>
      <view class="date-grid">
        <picker disabled="{{editMode && (!canManage || frozen)}}" mode="date" value="{{form.plannedStartDate}}" data-field="plannedStartDate" bindchange="updateDate"><view class="date-box">{{form.plannedStartDate || '计划开始日期'}}</view></picker>
        <picker disabled="{{editMode && (!canManage || frozen)}}" mode="date" value="{{form.plannedEndDate}}" data-field="plannedEndDate" bindchange="updateDate"><view class="date-box">{{form.plannedEndDate || '计划完成日期'}}</view></picker>
      </view>
    </view>

    <view wx:if="{{editMode}}">
      <view class="section-title">业务节点（只读）</view>
      <view class="card node" wx:for="{{nodes}}" wx:key="_id">
        <view class="row-between">
          <text class="node-name">{{index + 1}}. {{item.name}}</text>
          <status-pill status="{{item.status}}" />
        </view>
        <text class="muted block">{{item.nodeCode || '旧业务节点暂无自动编号'}}</text>
        <text class="muted block" wx:if="{{item.assigneeNamesText}}">负责人：{{item.assigneeNamesText}}</text>
      </view>
      <view class="empty" wx:if="{{!nodes.length}}">暂无节点快照</view>
    </view>

    <view class="form-error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
    <button
      class="primary-button save"
      bindtap="save"
      loading="{{saving}}"
      disabled="{{saving || loading || (editMode ? (!canManage || frozen) : !templateAvailable)}}"
    >{{editMode ? '保存基本信息' : '创建业务线'}}</button>
  </view>
</view>
