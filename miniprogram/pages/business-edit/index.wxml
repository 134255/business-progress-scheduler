<view class="page">
  <view class="empty" wx:if="{{loading}}">正在加载…</view>

  <view wx:else>
    <view wx:if="{{!editMode && templatePreview}}" class="card template-preview">
      <view class="row-between">
        <text class="preview-name">{{templatePreview.name}}</text>
        <text class="node-count">{{templatePreview.nodeCount}} 个节点</text>
      </view>
      <text class="muted block">{{templatePreview.description || '暂无模板说明'}}</text>
      <text wx:if="{{!templateAvailable}}" class="frozen-note">{{templatePreview.unavailableMessage}}</text>
    </view>

    <view wx:if="{{editMode}}" class="card immutable-summary">
      <text class="field-label">售后线名称</text>
      <text class="immutable-name">{{lineName}}</text>
      <text class="field-label">售后线编号</text>
      <text class="immutable-code">{{lineCode}}</text>
      <text class="muted block">名称、编号和节点均由模板快照生成，不可编辑</text>
      <text wx:if="{{legacyPlannedStartDate || legacyPlannedEndDate}}" class="muted block">历史计划日期：{{legacyPlannedStartDate || '未设置'}} 至 {{legacyPlannedEndDate || '未设置'}}</text>
      <text wx:if="{{frozen}}" class="frozen-note">售后已完成或关闭，结构化信息已冻结</text>
    </view>

    <view class="card">
      <view wx:if="{{!editMode}}" class="automatic-name-note">售后线名称将自动生成为：模板名称 + 售后线编号</view>
      <view class="field">
        <text class="field-label">说明</text>
        <textarea class="textarea" disabled="{{editMode && (!canManage || frozen)}}" data-field="description" value="{{form.description}}" bindinput="updateField" placeholder="补充售后背景、目标或特别要求" />
      </view>
    </view>

    <view wx:if="{{editMode}}">
      <view class="section-title">售后节点（只读）</view>
      <view class="card node" wx:for="{{nodes}}" wx:key="_id">
        <view class="row-between">
          <text class="node-name">{{index + 1}}. {{item.name}}</text>
          <status-pill status="{{item.status}}" />
        </view>
        <text class="muted block">{{item.nodeCode || '旧售后节点暂无自动编号'}}</text>
        <text class="muted block" wx:if="{{item.assigneeNamesText}}">负责人：{{item.assigneeNamesText}}</text>
      </view>
      <view class="empty" wx:if="{{!nodes.length}}">暂无节点快照</view>
    </view>

    <view class="form-error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
    <button
      class="primary-button save"
      bindtap="save"
      loading="{{saving}}"
      disabled="{{saving || loading || (editMode ? (!canManage || frozen) : !templateAvailable)}}"
    >{{editMode ? '保存基本信息' : '创建售后线'}}</button>
  </view>
</view>
