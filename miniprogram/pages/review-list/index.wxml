<view class="page">
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view class="card review-card" wx:for="{{items}}" wx:key="reviewRoundId" data-id="{{item.reviewRoundId}}" bindtap="openDetail">
    <view class="row-between"><text class="item-title">{{item.businessName}}</text><text class="mode">{{item.reviewModeLabel}}</text></view>
    <text class="muted block">售后编号：{{item.businessCode || '未编号'}}</text>
    <text class="block">{{item.nodeName}} · 第 {{item.reviewRoundNumber}} 轮审核</text>
    <text class="muted block">{{item.nodeCode}}</text>
    <text class="due block">{{item.dueText}}</text>
    <text class="action block">查看并审核 →</text>
  </view>
  <view wx:if="{{!loading && !errorMessage && !items.length}}" class="empty">暂无待审核事项</view>
  <view wx:if="{{loading}}" class="empty">正在加载审核待办…</view>
  <button wx:if="{{hasMore}}" class="secondary-button" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
</view>
